def test_merge_gitignore_reroots_generated_paths():
    merged = unify.merge_gitignore(TREE_GITIGNORE, ENGINE_GITIGNORE)
    for rerooted in (
        ".agi/sessions/", ".agi/context/INJECTION.md",
        ".agi/context/publish-state.json", ".agi/nodes.db",
        ".agi/.chain_cache.pkl", ".agi/loop.log", ".agi/payloads/",
    ):
        assert rerooted in merged, merged
    # context/INJECTION.md has no engine-side counterpart in this fixture, so
    # the un-rerooted form must not survive as a bare line at all.
    lines = set(merged.splitlines())
    assert "context/INJECTION.md" not in lines


def test_merge_gitignore_reroot_beats_dedup_for_names_shared_with_the_engine():
    """`sessions/` and `loop.log` are bare, unrelated entries in the ENGINE's
    own .gitignore too (its own generated files at the repo root). The
    graph's versions of those same names must still end up re-rooted under
    `.agi/`, as a second, distinct line -- not silently dropped as a
    "duplicate" of the engine's unrelated entry."""
    merged = unify.merge_gitignore(TREE_GITIGNORE, ENGINE_GITIGNORE)
    lines = merged.splitlines()
    assert lines.count("sessions/") == 1        # the engine's own, bare, unrelated
    assert lines.count(".agi/sessions/") == 1   # the graph's, re-rooted
    assert lines.count("loop.log") == 1         # the engine's own, bare, unrelated
    assert lines.count(".agi/loop.log") == 1    # the graph's, re-rooted


