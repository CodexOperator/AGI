#!/bin/sh
# agi-rc-keepalive (root, every 30 min): a claude.ai access token lives 8 h and a post that is IDLE at expiry never
# refreshes it, so its Remote Control link dies (2026-10-09 09:06-10:00Z, trap 95 on doc:card-belam). For every live
# agi-post@P whose token expires within LEAD seconds (or already has), type ONE cheap turn into P's pane -- the same
# fifo + separate CR that agi-run's mail wake uses -- so the session refreshes its own token. A busy post refreshes by
# itself and is never pinged. At most one ping per post per GAP seconds. Values are never read out: only expiresAt.
LEAD=${LEAD:-7200};GAP=${GAP:-3600};S=/run/agi-rc-keepalive;mkdir -p $S
MSG='keepalive: reply with the one word ok and do nothing else (owner 10-09: a turn refreshes your claude.ai login so Remote Control stays up).'
now=$(date +%s)
for u in $(systemctl list-units 'agi-post@*.service' --state=running --no-legend --plain | awk '{print $1}');do
 p=${u#agi-post@};p=${p%.service};case $p in ""|*[!a-z0-9-]*)continue;;esac
 c=/var/lib/agi/$p/.claude/.credentials.json;f=/run/agi-$p/i;[ -r "$c" ]&&[ -p "$f" ]||continue
 e=$(jq -r '.claudeAiOauth.expiresAt // empty' "$c" 2>/dev/null);[ -n "$e" ]||continue;e=$((e/1000))
 [ $((e-now)) -lt $LEAD ]||continue
 l=$(cat $S/$p 2>/dev/null||echo 0);[ $((now-l)) -ge $GAP ]||continue
 runuser -u agi-$p -- timeout 5 sh -c 'printf "%s" "$1" > "$2"' _ "$MSG" "$f"&&sleep 1&&runuser -u agi-$p -- timeout 5 sh -c 'printf "\r" > "$1"' _ "$f"&&echo $now>$S/$p&&logger -t agi-rc-keepalive "pinged $p (token $(( (e-now)/60 )) min from expiry)"
done
