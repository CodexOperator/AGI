export const meta = {
  name: 'agi-brief-drafting',
  description: 'Draft hypothesis briefs from owner text — one drafter per brief at the configured model/effort, then a critic pass; briefs, scratch dir and owner-section pointer come from args',
  phases: [{ title: 'Draft', detail: 'one drafter per brief, bodies to scratch files' }, { title: 'Critic', detail: 'one critic checks every draft against the owner text and fixes in place' }],
}
// Model/effort: single-run override via Workflow args {model, effort}; defaults mirror .agi/config.json workflows.drafting (owner 2026-09-07: easy to flip to opus/fable; later fully model- and provider-agnostic through the drafter seat + dispatch.py).
const MODEL = (args && args.model) || 'sonnet'
const EFFORT = (args && args.effort) || 'max'
// args: {model, effort, scratch, owner_section, briefs:[{slug,parent,scope}]} — defaults below are the wave-4 run of 2026-09-07 (Belam III); the config-maxxed form (workflows.drafting row, other harnesses) is hypothesis:l3w4-workflows-config-maxxed
const SCRATCH = (args && args.scratch) || '/tmp/agi-drafts'
const OWNER = (args && args.owner_section) || '.agi/context/l3-command-ladder-brief.md (the LAST section: "## Owner text 2026-09-07 (04:40–06:40 UTC, to Belam II after rotation) — perpetual seats, the quorum as reviewer, the owner liaison", owner verbatim (1)(2)(3), the CORRECTION (4), quote (5) on the drafter seat of 07:36 UTC which OVERRIDES (3) and the gloss on models and comms, + the "Director gloss (Belam II, proposal — not owner text)")'
const RULES = `HARD RULES: you are READ-ONLY on the repo /home/ubuntu/work/agi. Never run git (any verb), grid.py, write.py, dispatch.py, send.py send, rotate.py spawn, or edit/create any file inside the repo. Live agents are running in this repo right now; do not touch .agi/sessions. Write ONLY under ${SCRATCH}/ (mkdir -p it). Return raw structured data via StructuredOutput; no prose report.
