def make_tree_repo(tmp_path: Path) -> Path:
    """A tiny but real graph repo: config, GOALS.md, two node commits, two
    fake grid refs, a .gitignore modeled on the real one."""
    d = tmp_path / "tree"
    d.mkdir()
    _git(d.parent, "init", "-q", "-b", "master", str(d))

    (d / "agi-tree.config.json").write_text('{"metric_primary": "outcome_coverage"}\n')
    (d / "GOALS.md").write_text("# GOALS\n\n## G1: something\n")
    (d / ".gitignore").write_text(TREE_GITIGNORE)
    # CLAUDE.md + AGENTS.md, modeled on the real tree: AGENTS.md is a relative
    # symlink to CLAUDE.md, same directory, same as `/home/ubuntu/work/agi-tree`.
    # Both are required by relocate_files, so every fixture built with this
    # helper carries them, same as the real tree always does.
    (d / "CLAUDE.md").write_text("# CLAUDE.md\n\nProject instructions.\n")
    (d / "AGENTS.md").symlink_to("CLAUDE.md")
    goal_dir = d / "nodes" / "goal"
    goal_dir.mkdir(parents=True)
    (goal_dir / "g1.md").write_text(
        '---\nid: "goal:g1"\nmint_id: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ntype: goal\n'
        '---\n\nfirst version of g1\n'
    )
    kits_dir = d / "context" / "kits"
    kits_dir.mkdir(parents=True)
    (kits_dir / "example.md").write_text("a kit\n")

    _git(d, "add", "-A")
    _git(d, "commit", "-q", "-m", "tree: initial commit")
    first_commit = _rev_parse(d)

    (goal_dir / "g1.md").write_text(
        '---\nid: "goal:g1"\nmint_id: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ntype: goal\n'
        '---\n\nsecond version of g1, edited\n'
    )
    _git(d, "commit", "-aq", "-m", "tree: edit g1")
    tip = _rev_parse(d)

    _git(d, "update-ref", "refs/grid/node/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", tip)
    _git(d, "update-ref", "refs/grid/node/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", first_commit)

    return d


def _root_commit(repo: Path) -> str:
    """The very first commit of `repo`. Recomputed rather than threaded
    through as extra fixture state — `Path` cannot carry an ad-hoc attribute,
    and re-deriving it is one git call."""
    return _git(repo, "rev-list", "--max-parents=0", "HEAD")


def make_engine_repo(tmp_path: Path) -> Path:
    """A tiny but real engine repo: some source, its own .gitignore, two
    commits — standing in for a `git clone` of the real `agi`."""
    d = tmp_path / "engine"
    d.mkdir()
    _git(d.parent, "init", "-q", "-b", "master", str(d))

    (d / ".gitignore").write_text(ENGINE_GITIGNORE)
    ext = d / "extensions" / "agi" / "bin"
    ext.mkdir(parents=True)
    (ext / "hello.py").write_text("print('hello')\n")

    _git(d, "add", "-A")
    _git(d, "commit", "-q", "-m", "engine: initial commit")

    (ext / "hello.py").write_text("print('hello world')\n")
    _git(d, "commit", "-aq", "-m", "engine: tweak hello")

    return d


def _hash_tree(root: Path) -> dict[str, str]:
    """relpath -> sha256 of every regular file under `root`, for the
    zero-rewrite check: this migration must not change a single node byte."""
    out = {}
    for p in sorted(root.rglob("*")):
        if p.is_file():
            out[str(p.relative_to(root))] = hashlib.sha256(p.read_bytes()).hexdigest()
    return out


def _add_payload_node(tree: Path, node_name: str, payload_ref: str) -> Path:
    """Commit one more node under `<tree>/nodes/build/` carrying
    `payload_ref` — the shape `find_missing_payloads` (the publish-lag gate)
    reads, modeled on a real `build:` node in agi-tree
    (`payload_ref: extensions/agi/bin/...`, relative to the engine root)."""
    build_dir = tree / "nodes" / "build"
    build_dir.mkdir(parents=True, exist_ok=True)
    path = build_dir / f"{node_name}.md"
    path.write_text(
        f'---\nid: "build:{node_name}"\n'
        f'mint_id: cccccccccccccccccccccccccccccccc\ntype: build\n'
        f'payload_ref: {payload_ref}\n---\n\nBuild node.\n'
    )
    _git(tree, "add", "-A")
    _git(tree, "commit", "-q", "-m", f"tree: add {node_name}")
    return path


def _fingerprint(repo: Path) -> str:
    """Enough of `repo`'s state that "identical before and after a rollback"
    is one string comparison rather than eyeballing several: every ref with
    its sha, `ls-tree -r` (which carries file modes, so a lost symlink mode
    would show up here), and the on-disk working-tree file list. Modeled on
    rehearsal run 4's 682-line manual comparison, collapsed to one assertion.
    """
    refs = _git(repo, "for-each-ref", "--format=%(refname) %(objectname)")
    ls_tree = _git(repo, "ls-tree", "-r", "HEAD")
    working_files = sorted(
        str(p.relative_to(repo)) for p in repo.rglob("*") if ".git" not in p.parts
    )
    return "\n===\n".join([refs, ls_tree, "\n".join(working_files)])


@pytest.fixture()
def repos(tmp_path):
    engine = make_engine_repo(tmp_path)
    tree = make_tree_repo(tmp_path)
    return engine, tree


@pytest.fixture()
def migrated(repos):
    """Run the real migration once and hand back everything a test might
    want: the paths, the pre-migration node bytes (for the zero-rewrite
    check), and the report."""
    engine, tree = repos
    pre_nodes_hash = _hash_tree(tree / "nodes")
    tree_first_commit = _root_commit(tree)
    tree_tip = _rev_parse(tree)
    report = unify.run_unify(engine, tree, yes=True)
    return {
        "engine": engine, "tree": tree, "report": report,
        "pre_nodes_hash": pre_nodes_hash,
        "tree_first_commit": tree_first_commit,
        "tree_tip": tree_tip,
    }


