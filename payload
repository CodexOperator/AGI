TREE_GITIGNORE = """\
# agi engine symlink; never committed here, recreated by the caller.
agi

# Staged payload checkout (goal:g6.3). The committed home of these bytes is
# the node's own grid ref.
payloads/

# Generated by the loop. nodes/ IS committed -- the nodes are the thoughts.
sessions/
context/INJECTION.md
context/publish-state.json
nodes.db
.chain_cache.pkl
loop.log

# Agent worktrees + local caches
.claude/worktrees/
__pycache__/
*.pyc
.pytest_cache/
.coverage
