import json, sys, torch, numpy as np
sys.path.insert(0, "/data/work/agi/.agi/context/local-maxxing/osc"); sys.path.insert(0, "/data/work/agi/.agi/context/local-maxxing")
import osc_neuron_period as S, paths
from transformers import AutoModelForCausalLM, AutoTokenizer
out = paths.get_local("osc_neuron_period_dir"); P = json.load(open(out + "/params.json")); R = json.load(open(out + "/results.json"))
torch.set_num_threads(6); hf = paths.get(P["model_cell"]); tok = AutoTokenizer.from_pretrained(hf)
m = AutoModelForCausalLM.from_pretrained(hf, dtype=torch.float32).eval(); N = S.Neurons(m)
texts, gold = S.c2_problems(P); ids = S.encode(tok, texts[:50])
def run(ab):
    N.ablate(ab)
    with torch.no_grad(): lp = torch.log_softmax(m(input_ids=ids, logits_to_keep=1).logits[:, -1].double(), -1)
    N.ablate([]); return lp
base = run([])
print("=== diagnostic (post-verdict, not scored): first-answer-token KL(base||arm) and max |dlogprob| over 50 C2 prompts", flush=True)
for name, ab in R["c2"]["arms"].items():
    if not ab: continue
    lp = run(ab); kl = float((base.exp() * (base - lp)).sum(-1).mean())
    print(f"diag {name}: KL {kl:.3e} max|dlogp| {float((lp - base).abs().max()):.3e} top1 same {int((lp.argmax(-1) == base.argmax(-1)).sum())}/50", flush=True)
