{
  "name": "review",
  "script": "agi-round-review.js",
  "description": "Review one agi round: per-target parent/kid outputs with claim re-verification, plus one global-checks stage",
  "stages": [
    {
      "label": "global-checks",
      "role": "global",
      "model_hint": "sonnet",
      "effort_hint": "low",
      "schema": {
        "type": "object",
        "properties": {
          "git_status": { "type": "array" },
          "links_broken": { "type": "integer" },
          "goals_check_ok": { "type": "boolean" },
          "suite_passed": { "type": "integer" },
          "suite_failed": { "type": "integer" },
          "summary": { "type": "string" }
        },
        "required": ["git_status", "links_broken", "goals_check_ok", "summary"]
      }
    },
    {
      "label": "review",
      "role": "reviewer",
      "repeat": { "of": "targets", "label_template": "review:{window}" },
      "model_hint": "sonnet",
      "effort_hint": "medium",
      "schema": {
        "type": "object",
        "properties": {
          "hypothesis": { "type": "string" },
          "parent_agent": { "type": "string" },
          "verdict": { "type": "string" },
          "confidence": { "type": "string" },
          "overclaims": { "type": "array" },
          "open_gaps": { "type": "array" },
          "summary": { "type": "string" }
        },
        "required": ["hypothesis", "parent_agent", "verdict", "overclaims", "open_gaps", "summary"]
      }
    }
  ]
}