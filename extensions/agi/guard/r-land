#!/bin/sh
# r-land BASE TIP: the land rule for config:posts / config:seats rows (goal:g7.16.1.11.46.23, V8a tip 2c; the
# council's rows R1-R5, alive [decision] 20:37:08Z 10-25). Read by SM's gate, belam's verify-land and the
# reference-transaction prepared phase: the SAME script, the SAME BASE TIP. Exit 0 = ok, 1 = refused or unread.
#
# Every commit in BASE..TIP that changes the row list of posts.md / seats.md is judged BY ITS OWN SIGNER:
#  R1  the author is the SIGNER, `git verify-commit --raw` against the allowed_signers ring (AGI_RING, else
#      gpg.ssh.allowedSignersFile), never %an/%ae. An unsigned or unringed commit that changes a row is refused.
#  R2  per changed row, with every rule read from BASE's [config].md DATA (never a literal here): the signer holds
#      a role in `written_by`, OR changes only its OWN row's `self_row.fields` (and no protected cell), OR an
#      `actor_rows` grant covers actor + op + keys (deny list honoured). ADDED and DELETED rows need written_by or
#      an actor_rows `create`/`retire` grant; a rename is a delete plus an add; a post never mints its own row.
#      MOVE GRANT (owner "Accept both" 05:0xZ 10-26, council 3/3 alive 05:20:59Z; the same rule as card-belam 5f06bcb225 /
#      alive 23:12:35Z + 23:14:35Z 10-25 `retire_copy`, re-expressed): an actor_rows entry
#      `{actor, list_key, match_key, ops: [create], name_suffix: "-retired", move_of: "<x>"}` admits ONE create of a row named
#      `<x><suffix>` and nothing else (it is never a field grant: a set, or a create without it, is judged as before). The row is
#      admitted only if (1) `<x>` exists at the commit's PARENT (else `unread (<x> at <parent>)`), (2) `<x>` is gone from the commit
#      (retired in the SAME commit; the retire itself is the actor's own `retire` grant), (3) every cell but the 9 process cells
#      {name, session_label, boot, box, worktree, session_name, window, pid, recover} equals <x>'s (a changed pubkey / key_history /
#      role is refused), (4) the process cells read their retired values: name = session_label = `<x><suffix>`, boot null, box
#      "off", worktree / session_name / window "", pid 0, recover false (an absent cell reads as its empty value).
#  R3  anything unreadable (BASE/TIP, the schema, vetoes, ladder, a cell or its rows at a rev, a jq/yaml failure)
#      -> `R-land: unread (<what> at <rev>)`, refused. Never a pass on an empty diff.
#  veto  while BASE's config:vetoes holds an unanswered active_gate for scope `prime`, a row change that is not
#      the signer's own self_row write is refused.  town  a changed row's `town` must be in the ladder's
#      `towns:` plus the schema's `town_cell.also_accepted`.
#  The ok / report line ends `; N row op(s): a retire, b create, c set`: ROW ops judged (a posts.md change that moves two rows is 4, not "1 cell change"; council 09:23Z 10-26).
#  A merge commit that takes one parent's cell wholesale adds nothing (the commits it brought are judged on their
#  own); a merge that writes a NEW cell is judged against its first parent by the merge's signer.
#  MODE  ONE cell, BASE's [config].md `r_land: {mode: report|enforce}` (council 3/3 22:48Z 10-25, V8a re-cut to REPORT
#      MODE). enforce = rc 1 on a refusal, the caller keeps the ref. report = every would-be refusal (and every
#      unread) is PRINTED as `R-land: would refuse <commit> (<signer>, <row>, <op> <cells>, <rule>)`, rc 0, the ref moves.
#      The mode is read from BASE, never TIP (a range cannot soften its own judge). ABSENT at BASE = report (the
#      bootstrap state; a line says so). A mode that cannot be read, or is neither word, = enforce (fail closed).
#      The mode is read BEFORE anything else but the schema it lives in, and before the ring: the report-mode rc 1 set is
#      EXACTLY (a) a BASE or TIP that does not rev-parse, (b) a tmpdir that cannot be made, (c) the schema unreadable at BASE,
#      not a frontmatter mapping, or its r_land.mode neither word: the mode's own home, fail closed (they run before the
#      mode is known). Every later unread (vetoes, ladder, their yaml, the joined data, a cell's rows, the range, the ring)
#      prints `R-land: would refuse <tip> (unread <what>)` rc 0 in report and `R-land: unread (<what>)` rc 1 in enforce. The
#      ring is read only when a row change must be verified in report (a 0-change range needs none and says ok).
#      Flipping it is ONE commit on a RULES path, at all three call sites together (they all read this one cell).
#  W   (section at the end) who changed a node whose type declares `written_by` (BASE's schemas): moral / vision / town by PER-COMMIT
#      SIGNER (lines end (W1)); config by its LANDER, the first-parent commit that introduces it (a direct config leaf by a seat
#      outside written_by = a (W2) line; a land MERGE signed outside written_by = ONE report line `config: lander not provable in
#      history (RULES via unsigned ff)` with the count and leaf signers, never absorbing an R1 line, an unread or a leaf signer with
#      no seat by name or `was:` (c)); an unsigned / unringed lander or leaf is the R1 line. A `ran as` line names the process uid.
#  R5  what this is: enforced at every trunk move except a deliberate core.hooksPath bypass. A hook guards against
#      MISTAKES; it is not a wall.
# Reads ONLY git objects of BASE/TIP plus the ring file; writes nothing. sh + jq + one python3 yaml read.
# (Objects are read with `git cat-file blob REV:path`, never `git show`: for a path with brackets, like [config].md,
#  `git show REV:path` exits 0 with EMPTY output when the file is absent, and an absent schema would read as present.)
set -u
TA=${2:-?}; MODE=enforce   # until BASE's schema is read: an unreadable judge fails closed
U(){ if [ "$MODE" = report ]; then echo "R-land: would refuse ${T:-$TA} (unread $1)"; exit 0; fi; echo "R-land: unread ($1)"; exit 1; }
[ $# = 2 ]||{ echo "usage: r-land BASE TIP" >&2; exit 2; }
B=$(git rev-parse -q --verify "$1^{commit}" 2>/dev/null)||U "BASE $1"
T=$(git rev-parse -q --verify "$2^{commit}" 2>/dev/null)||U "TIP $2"
A=${AGI_RING:-$(git config --get gpg.ssh.allowedSignersFile 2>/dev/null)}
RING(){ [ -n "$A" ]&&[ -r "$A" ]||U "allowed_signers ring"; }   # called AFTER the mode is known (U reads MODE)
d=$(mktemp -d)||U "tmpdir"; trap 'rm -rf "$d"' EXIT
G=.agi/nodes/.geometry
# the mode lives in the SCHEMA, so the schema is read and parsed ALONE first, and MODE is set from it BEFORE any other cell is read:
# every later unread (vetoes, ladder, their yaml, a cell's rows, the range, the ring) is judged under the mode (U above).
git cat-file blob "$B:.agi/context/schemas/[config].md" >"$d/schema" 2>/dev/null||U "config schema at ${B%${B#????????}}"
yamlpass(){ # name... -> one JSON object {name: mapping}; rc 1 unless every named cell is a frontmatter mapping
python3 -I - "$d" "$@" <<'PY'
import sys, json, re, yaml
d, out = sys.argv[1], {}
for n in sys.argv[2:]:
    t = open(d + "/" + n, encoding="utf-8").read()
    m = re.match(r"---\n(.*?)\n---", t, re.S)
    v = yaml.safe_load(m[1]) if m else None
    if not isinstance(v, dict):
        sys.exit(1)
    out[n] = v
print(json.dumps(out, default=str))
PY
}
yamlpass schema >"$d/schema.json" 2>/dev/null||U "yaml frontmatter of the schema at ${B%${B#????????}}"
jq -e . "$d/schema.json" >/dev/null 2>&1||U "schema data at ${B%${B#????????}}"
case $(jq -r 'if (.schema.r_land|type)=="object" then (.schema.r_land.mode // "absent"|tostring) else "absent" end' "$d/schema.json" 2>/dev/null) in
  report) MODE=report;;
  enforce) MODE=enforce;;
  absent) MODE=report; echo "R-land: mode report (r_land.mode absent at ${B%${B#????????}})";;
  *) U "r_land.mode at ${B%${B#????????}}: neither report nor enforce";;
esac
git cat-file blob "$B:$G/vetoes.md" >"$d/vetoes" 2>/dev/null||U "vetoes at ${B%${B#????????}}"
git cat-file blob "$B:$G/ladder.md" >"$d/ladder" 2>/dev/null||U "ladder at ${B%${B#????????}}"
yamlpass vetoes ladder >"$d/vl.json" 2>/dev/null||U "yaml frontmatter of vetoes/ladder at ${B%${B#????????}}"
jq -s '.[0] + .[1] | {schema, vetoes, ladder}' "$d/schema.json" "$d/vl.json" >"$d/data.json" 2>/dev/null||U "data at ${B%${B#????????}}"
V=refused; [ $MODE = report ]&&V="would refuse"
[ $MODE = enforce ]&&RING   # enforce reads the ring up front (fail closed); report reads it only when a row change is judged

# rows of a cell at a rev: [] when the cell is absent there, unread when it exists but does not parse
rows(){ # rev cell -> file
  if git cat-file -e "$1:$G/$2" 2>/dev/null; then
    git cat-file blob "$1:$G/$2" 2>/dev/null|sed -n 's/^  - {/{/p'|jq -s . >"$3" 2>/dev/null||U "$2 rows at ${1%${1#????????}}"
  else echo '[]' >"$3"; fi
}
rows "$B" posts.md "$d/b.posts"; rows "$B" seats.md "$d/b.seats"
jq -s 'add' "$d/b.posts" "$d/b.seats" >"$d/brows" 2>/dev/null||U "BASE rows"

nchg=0; bad=0; opc=0; opr=0; ops=0       # opc/opr/ops = row ops judged: create / retire / set (a cell file with 2 moves is 4 row ops, not 1 change)
git rev-list --reverse "$B..$T" >"$d/revs" 2>/dev/null||U "range ${B%${B#????????}}..${T%${T#????????}}"
while read -r c; do
  par=$(git rev-list --parents -n1 "$c"|sed 's/^[^ ]* *//')
  [ -n "$par" ]||continue                       # a root commit in the range: nothing to diff against
  p1=${par%% *}; merge=0; [ "$par" != "$p1" ]&&merge=1
  for cell in posts.md seats.md; do
    bc=$(git rev-parse -q --verify "$c:$G/$cell" 2>/dev/null||true); b1=$(git rev-parse -q --verify "$p1:$G/$cell" 2>/dev/null||true)
    [ "$bc" = "$b1" ]&&continue
    if [ $merge = 1 ]; then               # a merge that takes ANY parent's cell wholesale adds nothing new
      same=0; for q in $par; do [ "$(git rev-parse -q --verify "$q:$G/$cell" 2>/dev/null||true)" = "$bc" ]&&same=1; done
      [ $same = 1 ]&&continue
    fi
    nchg=$((nchg+1)); RING
    s=$(git -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$A" verify-commit --raw "$c" 2>&1|sed -n 's/.*signature for \([^@]*\)@agi with.*/\1/p'|head -1)
    if [ -z "$s" ]; then echo "R-land: $V ${c%${c#????????}} (nobody, $cell, -, changes $cell but is signed by nobody the ring knows (R1))"; bad=$((bad+1)); continue; fi
    rows "$p1" "$cell" "$d/before"; rows "$c" "$cell" "$d/after"
    o3=$(jq -r -n --slurpfile Bf "$d/before" --slurpfile Af "$d/after" '
      ($Bf[0]|map({(.name|tostring):.})|add//{}) as $o | ($Af[0]|map({(.name|tostring):.})|add//{}) as $n | (($o|keys)+($n|keys)|unique) as $k
      | "\([$k[]|select($o[.]==null and $n[.]!=null)]|length) \([$k[]|select($o[.]!=null and $n[.]==null)]|length) \([$k[]|select($o[.]!=null and $n[.]!=null and $o[.]!=$n[.])]|length)"' 2>/dev/null)||o3=
    case "$o3" in [0-9]*" "[0-9]*" "[0-9]*) opc=$((opc+${o3%% *})); t3=${o3#* }; opr=$((opr+${t3%% *})); ops=$((ops+${t3#* }));; esac
    jq -r -n --arg v "$V" --arg s "$s" --arg c "${c%${c#????????}}" --arg pp "${p1%${p1#????????}}" --slurpfile D "$d/data.json" --slurpfile Bf "$d/before" \
      --slurpfile Af "$d/after" --slurpfile Br "$d/brows" '
      ($D[0].schema) as $sc | ($D[0].vetoes) as $vt | ($D[0].ladder) as $ld
      | ($sc.written_by // []) as $wb0
      | (if ($wb0|type)=="string" then ($wb0|gsub(","; " ")|split(" ")|map(select(length>0))) else $wb0 end) as $wb
      | ($sc.self_row // {}) as $sr | ($sr.fields // []) as $srf
      | ($sc.actor_rows // []) as $ar
      | (["role","model","tier","harness","effort","owning_goal","worktree","rotated_by"]) as $prot
      | (($sc.town_cell.also_accepted // []) + (if (($sc.town_cell.accepted_from // "")|startswith("ladder")) then ($ld.towns // []) else [] end)) as $towns
      | (($vt.active_gates // []) | any(.scope=="prime" and ((.answered // "")==""))) as $frozen
      | ($Br[0] | map(select(.name==$s)) | .[0].role // "") as $role
      | ($Bf[0] | map({(.name|tostring): .}) | add // {}) as $o
      | ($Af[0] | map({(.name|tostring): .}) | add // {}) as $n
      | (($o|keys) + ($n|keys) | unique)[] as $name
      | select($o[$name] != $n[$name])
      | (if $o[$name]==null then "create" elif $n[$name]==null then "retire" else "set" end) as $op
      | (($o[$name] // {}) as $a | ($n[$name] // {}) as $b | [($a|keys[]),($b|keys[])] | unique | map(select($a[.] != $b[.])) | map(select(. != "name"))) as $ks
      | (($wb|index($role)) != null) as $w
      | ($op=="set" and $name==$s and ($ks|all(. as $k | ($srf|index($k)) != null)) and ($ks|all(. as $k | ($prot|index($k))==null))) as $self
      | ([$ar[] | . as $g | select($g.actor==$s and (($g.list_key // "")=="posts" or ($g.list_key // "")=="seats") and ($g.match_key != null)
            and (($g.ops // ["set"])|index($op)) != null and (($g.deny_roles // [])|index($name)) == null
            and ($g.name_suffix == null) and ($g.move_of == null)
            and ($op=="retire" or ($ks|all(. as $k | ((($g.fields // [])|index($k)) != null) or ($name==$s and (($srf|index($k)) != null))))))] | length > 0) as $gplain
      | (["name","session_label","boot","box","worktree","session_name","window","pid","recover"]) as $pc
      | ([$ar[] | . as $g | select($g.actor==$s and (($g.list_key // "")=="posts" or ($g.list_key // "")=="seats") and ($g.match_key != null)
            and (($g.ops // [])|index("create")) != null and (($g.name_suffix|type)=="string") and (($g.name_suffix|length) > 0)
            and $g.move_of == "<x>" and ($name|endswith($g.name_suffix)) and (($name|length) > ($g.name_suffix|length)))] | .[0]) as $mg
      | (if $mg == null then "" else $name[0:(($name|length) - ($mg.name_suffix|length))] end) as $x
      | (if $mg == null or $op != "create" then ""
         elif $o[$x] == null then "unread (\($x) at \($pp)): a \($mg.name_suffix) create moves a row that exists at its parent (move_of)"
         elif $n[$x] != null then "\($x) is still live: a \($mg.name_suffix) create must retire \($x) in the same commit (move_of)"
         else
           ($o[$x] | with_entries(select(.key as $k | ($pc|index($k)) == null))) as $xa
           | ($n[$name] | with_entries(select(.key as $k | ($pc|index($k)) == null))) as $xb
           | ([($xa|keys[]),($xb|keys[])] | unique | map(select($xa[.] != $xb[.]))) as $diff
           | $n[$name] as $r
           | if ($diff|length) > 0 then "cells \($diff|join(",")) differ from \($x): a move copies every cell but the process cells (move_of)"
             elif $r.session_label != $name then "session_label must equal the name \($name) (move_of)"
             elif ($r.boot != null) or (($r.box // "") != "off") or (($r.worktree // "") != "") or (($r.session_name // "") != "") or (($r.window // "") != "") or (($r.pid // 0) != 0) or (($r.recover // false) != false) then "process cells of \($name) must read boot null, box off, worktree/session_name/window empty, pid 0, recover false (move_of)"
             else "" end
         end) as $mvwhy
      | ($gplain or ($mg != null and $op == "create" and $mvwhy == "")) as $grant
      | (if $op=="create" and $name==$s then "a post never mints its own row (R2)"
         elif $op=="create" and ($w|not) and ($gplain|not) and $mg != null and $mvwhy != "" then $mvwhy
         elif ($op=="create" or $op=="retire") and ($w|not) and ($grant|not) then "\($op) of a row needs a written_by role or an actor_rows grant; \($s) (role \($role // "none")) has neither (R2)"
         elif $op=="set" and ($w|not) and ($self|not) and ($grant|not) then "cells \($ks|join(",")) of another post'"'"'s row (or outside self_row.fields) are admitted by no written_by role, self_row or actor_rows grant for \($s) (role \($role // "none")) (R2)"
         elif $frozen and ($self|not) then "scope prime is FROZEN by an unanswered human gate; only the signer'"'"'s own self_row write passes (veto)"
         elif ($op!="retire") and ($n[$name].town != null) and ($n[$name].town != ($o[$name].town // null)) and (($towns|index($n[$name].town)) == null) then "town \($n[$name].town|tojson) is outside the accepted vocabulary (town)"
         else empty end) as $why
      | "R-land: \($v) \($c) (\($s), \($name), \($op) \($ks|join(",")), \($why))"' >"$d/out" 2>"$d/err"||U "jq on $cell at ${c%${c#????????}}"
    if [ -s "$d/out" ]; then cat "$d/out"; bad=$((bad+$(wc -l <"$d/out"))); fi
  done
done <"$d/revs"
# ---- W: who changed a node whose type declares written_by (goal:g7.16.1.11.46.23; council 3/3 alive 02:53:20Z + 02:54:27Z 10-26)
# moral / vision / town: PER-COMMIT SIGNER (a leaf is judged by its own signer; the quiet owner-only types). config: the LANDER, the
# first-parent commit of BASE..TIP that introduces the change (a config leaf ff'd straight onto the ref is its own lander). A land MERGE
# whose signer holds no written_by role (SM is a director) prints ONE named report line `config: lander not provable in history (RULES
# via unsigned ff)` with the count and the leaf signers; it NEVER absorbs an R1 line, an unread or a leaf signer with no seat (each
# prints BESIDE it); an unsigned / unringed lander is the R1 line. posts.md / seats.md rows are judged above, not here. Same mode cell,
# same three call sites; `R-land: ran as <post> (user <name>, uid <n>)` names this run's PROCESS uid (id -un, never AGI_POST), informational only.
git diff --name-only "$B" "$T" -- .agi/nodes >"$d/nwb" 2>/dev/null; nrc=$?   # a git error is a CHANGE (council P1): the section runs, never a silent skip
nwb=$(grep -c '\.md$' "$d/nwb")
if [ "$nrc" != 0 ] || [ "${nwb:-0}" != 0 ]; then
python3 -I - "$B" "$T" "$MODE" "$A" >"$d/wb.out" 2>/dev/null <<'PY'||U "written_by section at ${B%${B#????????}}..${T%${T#????????}}"
import collections, json, re, subprocess, sys
BASE, TIP, MODE, RING = sys.argv[1:5]
V = "would refuse" if MODE == "report" else "refused"
G = ".agi/nodes/.geometry"
def git(*a):
    r = subprocess.run(["git", *a], capture_output=True, text=True)
    if r.returncode != 0:      # a git that cannot answer is an UNREAD, never an empty answer (council P1)
        unread(f"git {a[0]} failed rc {r.returncode} in the written_by section")
    return r.stdout
def blob(rev, path):
    r = subprocess.run(["git", "cat-file", "blob", f"{rev}:{path}"], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None
def s8(c):
    return c[:8]
def unread(what):
    print(f"R-land: would refuse {s8(TIP)} (unread {what})" if MODE == "report" else f"R-land: unread ({what})")
    sys.exit(0)
def head(t):
    m = re.match(r"---\n(.*?)\n---", t or "", re.S)
    return m[1] if m else ""
try:
    import yaml
except Exception:
    unread("yaml for the written_by section")
types = {}
for path in git("ls-tree", "--name-only", BASE, ".agi/context/schemas/").split("\n"):
    m = re.search(r"\[([a-z_-]+)\]\.md$", path)
    if not m:
        continue
    t = blob(BASE, path)
    try:
        f = yaml.safe_load(head(t)) if t is not None else None
    except Exception:
        f = None
    if not isinstance(f, dict):
        unread(f"schema {path} at {s8(BASE)}")
    wb = f.get("written_by")
    if wb is None:
        continue
    types[m.group(1)] = [x for x in re.split(r"[,\s]+", wb) if x] if isinstance(wb, str) else [str(x) for x in wb]
rows = {}
for cell in ("posts.md", "seats.md"):
    for ln in (blob(BASE, f"{G}/{cell}") or "").splitlines():
        if ln.startswith("  - {"):
            try:
                r = json.loads(ln[4:])
            except Exception:
                unread(f"{cell} rows at {s8(BASE)}")
            if isinstance(r, dict) and r.get("name"):
                rows.setdefault(r["name"], r)
def role_of(name):
    seen, todo = {name}, [name]
    while todo:
        n = todo.pop()
        if n in rows:
            return rows[n].get("role")
        for r in rows.values():
            if r.get("was") == n and r["name"] not in seen:
                seen.add(r["name"]); todo.append(r["name"])
    return None
sig = None
def signer(c):
    """The ring-verified signer name of c, else None. The ring is read ONLY when a judged node change needs it (a range that
    changes no node of a written_by type needs none), and an unreadable ring is the mode-aware unread."""
    global sig
    if sig is None:
        import os
        if not (RING and os.path.isfile(RING) and os.access(RING, os.R_OK)):
            unread("allowed_signers ring")
        sig = {}
        for ln in git("-c", "gpg.format=ssh", "-c", f"gpg.ssh.allowedSignersFile={RING}", "log", "--format=%H\t%G?\t%GS", f"{BASE}..{TIP}").splitlines():
            h, g, s = (ln.split("\t") + ["", ""])[:3]
            sig[h] = s.split("@")[0] if g == "G" and s.endswith("@agi") else None
    return sig.get(c)
parents = {}
for ln in git("rev-list", "--parents", f"{BASE}..{TIP}").splitlines():
    p = ln.split()
    parents[p[0]] = p[1:]
def changed(c, parent):
    res = []
    for ln in git("diff-tree", "-r", "--no-renames", "--name-status", parent, c, "--", ".agi/nodes").splitlines():
        st, _, p = ln.partition("\t")
        if p.endswith(".md") and not p.endswith((f"{G}/posts.md", f"{G}/seats.md")):
            res.append((st[0], p))
    return res
def ntype(path, new, old):
    for rev in (new, old):
        t = blob(rev, path) if rev else None
        if t is not None:
            m = re.search(r"^type:[ \t]*([A-Za-z_-]+)[ \t]*$", head(t), re.M)
            if m:
                return m.group(1)
    return None
out = []
def r1(c, p, typ):
    out.append(f"R-land: {V} {s8(c)} (nobody, {p}, -, changes {typ} node but is signed by nobody the ring knows (R1))")
def op(st):
    return {"A": "create", "D": "retire"}.get(st, "set")
def ok(s, roles):
    return s is not None and (role_of(s) in roles or s in roles)
# per-commit types
for c in git("rev-list", "--reverse", f"{BASE}..{TIP}").split():
    par = parents.get(c) or []
    if not par:
        continue
    for st, p in changed(c, par[0]):
        if len(par) > 1 and any(blob(q, p) == blob(c, p) for q in par[1:]):
            continue
        typ = ntype(p, c if st != "D" else None, par[0])
        if typ is None or typ == "config" or typ not in types:
            continue
        s = signer(c)
        if s is None:
            r1(c, p, typ)
        elif not ok(s, types[typ]):
            out.append(f"R-land: {V} {s8(c)} ({s}, {p}, {op(st)} {typ}, written_by: {', '.join(types[typ])}; signer role {role_of(s) or 'none'} (W1))")
# config: the lander
nconf, nprov, leafs = 0, 0, collections.Counter()
if "config" in types:
    roles = types["config"]
    for lander in git("rev-list", "--first-parent", "--reverse", f"{BASE}..{TIP}").split():
        par = parents.get(lander) or []
        if not par:
            continue
        items = [(st, p) for st, p in changed(lander, par[0]) if ntype(p, lander if st != "D" else None, par[0]) == "config"]
        if not items:
            continue
        s = signer(lander)
        merge = len(par) > 1
        leaves = git("rev-list", "--no-merges", f"{par[0]}..{par[1]}").split() if merge else []
        for st, p in items:
            nconf += 1
            if s is None:
                r1(lander, p, "config")
            elif ok(s, roles):
                continue
            elif merge:
                nprov += 1
                for lf in leaves:
                    lpar = parents.get(lf)
                    if not lpar or not any(pp == p for _, pp in changed(lf, lpar[0])):
                        continue
                    ls = signer(lf)
                    if ls is None:
                        r1(lf, p, "config")
                    elif role_of(ls) is None and ls not in roles:
                        out.append(f"R-land: {V} {s8(lf)} ({ls}, {p}, -, leaf signer has no seat at {s8(BASE)} and none reachable by was: (c))")
                    else:
                        leafs[ls] += 1
            else:
                out.append(f"R-land: {V} {s8(lander)} ({s}, {p}, {op(st)} config, written_by: {', '.join(roles)}; direct lander role {role_of(s) or 'none'} (W2))")
if nprov:
    who = ", ".join(f"{k} x{v}" for k, v in leafs.most_common()) or "none found"
    out.append(f"R-land: config: lander not provable in history (RULES via unsigned ff): {nprov} change(s); leaf signers: {who}")
if nconf:     # informational only: never a verdict input, never in the rc-1 set (council 03:25Z: it names the PROCESS uid, never AGI_POST)
    def idq(*a):
        r = subprocess.run(["id", *a], capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    u, n = idq("-un"), idq("-u")
    post = u[4:] if u.startswith("agi-") else u
    if u and post in rows:
        out.append(f"R-land: ran as {post} (user {u}, uid {n or '?'})")
    elif u:
        out.append(f"R-land: ran as: unread (user {u}, uid {n or '?'}; no seat row of that name)")
    else:
        out.append(f"R-land: ran as: unread (uid {n or '?'}; no name)")
print("\n".join(out))
