#!/bin/sh
# agi-quiet-watch (root, every minute): the town can stall with every post idle at its prompt and nothing unread --
# each one waiting on another (02:3xZ 10-11: SM idle after a compaction, the council waiting on SM's bigger outcomes,
# DG4 on SM's placements, DT-1 on TM). Owner 02:3xZ 10-11, verbatim: "Maybe an automated check if all posts are quiet
# for 5 mins and no process send a mail alert to SM". A post is BUSY when its newest transcript (~/.claude/projects/
# **/*.jsonl) is younger than Q seconds, or its claude has any descendant other than the MCP server (a tool call, a
# background task, a Monitor). When EVERY running post but belam is quiet, box-mail sanctuary-master once, signed as
# belam (the matrix allows belam -> SM); then at most once per GAP seconds until some post is busy again.
Q=${Q:-300};GAP=${GAP:-1800};S=${S:-/run/agi-quiet-watch};SELF=${SELF:-belam};TO=${TO:-sanctuary-master};mkdir -p "$S"
now=$(date +%s);list=;n=0
desc(){ for c in $(pgrep -P "$1");do case "$(tr '\0' ' ' </proc/$c/cmdline 2>/dev/null)" in *@gitkraken*|*'gk mcp'*)continue;;esac;echo "$c";desc "$c";done;}
for u in $(systemctl list-units 'agi-post@*.service' --state=running --no-legend --plain | awk '{print $1}');do
 p=${u#agi-post@};p=${p%.service};case $p in ""|*[!a-z0-9-]*|"$SELF")continue;;esac
 c=$(pgrep -u "agi-$p" -x claude | head -1);[ -n "$c" ]||continue
 t=$(find "/var/lib/agi/$p/.claude/projects" -name '*.jsonl' -printf '%T@\n' 2>/dev/null | sort -n | tail -1);t=${t%.*}
 a=$((now-${t:-0}));k=$(desc "$c" | wc -l)
 if [ "$a" -lt "$Q" ] || [ "$k" -gt 0 ];then rm -f "$S/last";exit 0;fi
 list="$list $p:$((a/60))m";n=$((n+1))
done
[ "$n" -gt 0 ]||exit 0
l=$(cat "$S/last" 2>/dev/null||echo 0);[ $((now-l)) -ge "$GAP" ]||exit 0
m="[quiet] agi-quiet-watch $(date -u +%H:%MZ) -> $TO: every post is idle at its prompt >= $((Q/60)) min with no tool or background process running ($n posts, idle for:$list). Nothing unread means everyone is waiting on someone: you are the board coordinator -- take the next owed step (placements, a return, the loop end: bigger outcomes -> council), or mail the post that owes one. If the season's work is truly done, say so to belam."
if printf '%s\n' "$m" | runuser -u "agi-$SELF" -- env HOME="/var/lib/agi/$SELF" AGI_POST="$SELF" PATH="/var/lib/agi/$SELF/bin:/opt/agi/bin:/usr/local/bin:/usr/bin:/bin" sh -c 'cd ~/t && box send "$1"' _ "$TO";then
 echo "$now" >"$S/last";logger -t agi-quiet-watch "quiet alert to $TO:$list"
else logger -t agi-quiet-watch "box send to $TO FAILED:$list";fi
