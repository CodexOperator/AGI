#!/bin/sh
# agi-quiet-watch (root, every minute): the town can stall with every post idle at its prompt and nothing unread --
# each one waiting on another (02:3xZ 10-11: SM idle after a compaction, the council waiting on SM's bigger outcomes,
# DG4 on SM's placements, DT-1 on TM). Owner 02:3xZ 10-11, verbatim: "Maybe an automated check if all posts are quiet
# for 5 mins and no process send a mail alert to SM". A post is BUSY when its newest transcript (~/.claude/projects/
# **/*.jsonl) is younger than Q seconds, or its screen log ~/o changed in the last QUIET seconds (a turn or a foreground
# tool redraws its spinner). WAS: "or its claude has any descendant but the MCP server" -- a background shell held that true
# for good, so the town sat idle 15 h after L121 (02:34Z-18:0xZ 10-25) and this never fired (belam 18:2xZ 10-25). When EVERY running post but belam is quiet, spool ONE alarm for sanctuary-master (belam's spool; belam's
# drain signs and sends it as belam: the matrix allows belam -> SM); then at most once per GAP seconds until some post is busy again.
Q=${Q:-300};QUIET=${QUIET:-60};GAP=${GAP:-1800};S=${S:-/run/agi-quiet-watch};SELF=${SELF:-belam};TO=${TO:-sanctuary-master};AS=${AS:-/opt/agi/bin/alarm_spool.py};STORES=${STORES:-/var/lib/agi};mkdir -p "$S"
now=$(date +%s);list=;n=0
for u in $(systemctl list-units 'agi-post@*.service' --state=running --no-legend --plain | awk '{print $1}');do
 p=${u#agi-post@};p=${p%.service};case $p in ""|*[!a-z0-9-]*|"$SELF")continue;;esac
 c=$(pgrep -u "agi-$p" -x claude | head -1);[ -n "$c" ]||continue
 t=$(find "/var/lib/agi/$p/.claude/projects" -name '*.jsonl' -printf '%T@\n' 2>/dev/null | sort -n | tail -1);t=${t%.*}
 a=$((now-${t:-0}));o=$(stat -c %Y "$STORES/$p/o" 2>/dev/null||echo 0)
 if [ "$a" -lt "$Q" ] || [ $((now-o)) -lt "$QUIET" ];then rm -f "$S/last";exit 0;fi
 list="$list $p:$((a/60))m";n=$((n+1))
done
[ "$n" -gt 0 ]||exit 0
l=$(cat "$S/last" 2>/dev/null||echo 0);[ $((now-l)) -ge "$GAP" ]||exit 0
m="[quiet] agi-quiet-watch $(date -u +%H:%MZ) -> $TO: every post is idle at its prompt >= $((Q/60)) min with no tool or background process running ($n posts, idle for:$list). Nothing unread means everyone is waiting on someone: you are the board coordinator -- take the next owed step (placements, a return, the loop end: bigger outcomes -> council), or mail the post that owes one. If the season's work is truly done, say so to belam."
# ROOT NEVER SIGNS (council 3/3 21:3xZ, .40.1 item 4): this unit only APPENDS a plain line, no key, to the sending seat's
# spool by runuser as that seat; the seat's own drain (config:crons alarm_drain_belam, user agi-belam) signs and box-sends it
# exactly once. alarm_spool.py is installed to /opt/agi/bin (stdlib only): the engine tree of a seat may lag or move.
if runuser -u "agi-$SELF" -- python3 "$AS" append --job quiet-watch --to "$TO" --text "$m" --max-lines 500 --spool "$STORES/$SELF/alarm.spool";then
 echo "$now" >"$S/last";logger -t agi-quiet-watch "quiet alert spooled for $TO:$list"
else logger -t agi-quiet-watch "spool append for $TO FAILED:$list"
 # a failed append is also ONE ~/.notice line in the seat's own file (written BY the seat's uid, root signs nothing), never the journal alone; no `last` stamp, so the next minute tries again
 runuser -u "agi-$SELF" -- env HOME="$STORES/$SELF" sh -c '[ -x ~/bin/agi-notice ] && exec ~/bin/agi-notice add "$0" || echo "$0" >> ~/.notice' "[quiet-watch-unspooled] $(printf %08x "$now") $(date -u +%H:%MZ) the quiet alert for $TO was NOT spooled ($n posts idle:$list)" >/dev/null 2>&1;fi
