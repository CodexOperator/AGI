# sanctuary guard layer 1. Written by {{GUARD_SRC}}.
# Edit guard.env or the script and re-run it; do not hand-edit this file. See {{GUARD_DOC}}.
# Ubuntu's package already has oomd watch user@.service at 50% pressure; these
# are the defaults any watched unit inherits unless it sets its own limit.
[OOM]
SwapUsedLimit={{OOMD_SWAP_PCT}}%
DefaultMemoryPressureLimit={{OOMD_PRESSURE_PCT}}%
DefaultMemoryPressureDurationSec={{OOMD_PRESSURE_SEC}}
