#!/usr/bin/env python3
"""agi-memguard ({{OWNER_USER}}-S2-L5-V, owner 09-25 after the 04:00Z OOM took every seat down).
Every 5 s: the 5 posts' Claude processes, tmux and the stream keep oom_score_adj -900 + nice -5, and so does a pi whose
cgroup is a post's (/agi.slice/agi-post@*.service); every other pi worker gets +500 (the kernel kills them first);
any process over 70% of RAM, or the largest unprotected one when MemAvailable < 1 GiB, is SIGSTOPped (suspended, never killed);
a drop of >= 3 GiB within 30 s alerts. Alerts: journal + {{MEMGUARD_LOG}}
+ one [red] dm to {{OWNER_USER}} (rate-limited 10 min)."""
import os, re, time, signal, subprocess, collections
PAGE = os.sysconf('SC_PAGE_SIZE'); ME = os.getpid()
def meminfo(k): return int(re.search(rf'^{k}:\s+(\d+)', open('/proc/meminfo').read(), re.M).group(1)) * 1024
TOTAL = meminfo('MemTotal')
PROTECT_COMM = {{PROTECT_COMM}}
PROTECT_CMD = re.compile(r'{{PROTECT_CMD}}')
PI_CMD = re.compile(r'{{PI_CMD}}')
POST_CG = re.compile(r'{{POST_CGROUP_RE}}', re.M)
hist = collections.deque(); stopped = set(); last_alert = 0.0
def log(msg, red=False):
    global last_alert
    line = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()) + ' ' + msg
    open('{{MEMGUARD_LOG}}', 'a').write(line + '\n'); subprocess.run(['logger', '-t', 'agi-memguard', msg])
    if red and time.time() - last_alert > {{ALERT_COOLDOWN_S}}:
        last_alert = time.time()
        subprocess.run(['sudo', '-u', '{{OWNER_USER}}', '-H', 'python3', '{{REPO_ROOT}}/extensions/agi/bin/send.py', 'send', '--from', '{{OWNER_USER}}', '{{OWNER_USER}}', '[red] memguard: ' + msg],
                       cwd='{{REPO_ROOT}}', timeout=60, capture_output=True)
def procs():
    for d in os.listdir('/proc'):
        if not d.isdigit() or int(d) in (1, ME): continue
        try:
            comm = open(f'/proc/{d}/comm').read().strip(); cmd = open(f'/proc/{d}/cmdline').read().replace('\0', ' ')
            rss = int(open(f'/proc/{d}/statm').read().split()[1]) * PAGE
        except Exception: continue
        if cmd: yield int(d), comm, cmd, rss
def post_pi(pid, comm, cmd):
    if comm != '{{POST_PI_COMM}}' and not PI_CMD.search(cmd): return False
    try: return bool(POST_CG.search(open(f'/proc/{pid}/cgroup').read()))
    except Exception: return False
def setadj(pid, v):
    try:
        p = f'/proc/{pid}/oom_score_adj'
        if int(open(p).read()) != v: open(p, 'w').write(str(v))
    except Exception: pass
while True:
    now = time.time(); avail = meminfo('MemAvailable'); hist.append((now, avail))
    while hist and now - hist[0][0] > {{HISTORY_S}}: hist.popleft()
    peak = max(a for _, a in hist)
    if peak - avail >= {{SPIKE_BYTES}} << 30: log(f'SPIKE: MemAvailable fell {(peak-avail)>>20} MiB in <=30 s, now {avail>>20} MiB', red=True); hist.clear(); hist.append((now, avail))
    unprot = []
    for pid, comm, cmd, rss in procs():
        prot = comm in PROTECT_COMM or bool(PROTECT_CMD.search(cmd)) or post_pi(pid, comm, cmd)
        if prot:
            setadj(pid, {{PROTECT_OOM_ADJ}})
            try:
                if os.getpriority(os.PRIO_PROCESS, pid) > {{PROTECT_NICE}}: os.setpriority(os.PRIO_PROCESS, pid, {{PROTECT_NICE}})
            except Exception: pass
        elif PI_CMD.search(cmd): setadj(pid, {{PI_OOM_ADJ}})
        if not prot: unprot.append((rss, pid, comm))
        if rss > {{SUSPEND_RATIO}} * TOTAL and pid not in stopped:
            os.kill(pid, signal.SIGSTOP); stopped.add(pid); log(f'SUSPENDED pid {pid} ({comm}): RSS {rss>>20} MiB > {{SUSPEND_PCT}}% of {TOTAL>>20} MiB -- resume: kill -CONT {pid}', red=True)
    if avail < {{LOW_AVAIL_BYTES}} << 30 and unprot:
        rss, pid, comm = max(unprot)
        if pid not in stopped:
            os.kill(pid, signal.SIGSTOP); stopped.add(pid); log(f'SUSPENDED pid {pid} ({comm}, RSS {rss>>20} MiB): MemAvailable {avail>>20} MiB < {{LOW_AVAIL_GIB}} GiB -- resume: kill -CONT {pid}', red=True)
    stopped = {p for p in stopped if os.path.exists(f'/proc/{p}')}
    time.sleep({{INTERVAL_S}})
