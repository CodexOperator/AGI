#!/usr/bin/env python3
"""agi-memguard ({{OWNER_USER}}-S2-L5-V, owner 09-25 after the 04:00Z OOM took every seat down).
Every 5 s: a post's SPINE and HARNESS keep oom_score_adj -900 + nice -5, chosen by the post's cgroup
(/agi.slice/agi-post@*.service) AND their place in the unit's process tree, never by a command name: the spine is the chain
from the unit's oldest process down to the first process that has more than one child or a child whose argv is the tail of
its own (the tracer, and the harness is that child), plus everything the tracer runs that is not the harness; the harness's
DESCENDANTS (tool calls, MCP servers, kids) and anything orphaned out of the tree stay unprotected. tmux and the stream keep
-900 too (by command, outside the posts); every other pi worker gets +500 (the kernel kills them first);
a process over 70% of RAM, or the largest unprotected one when MemAvailable < 1 GiB, is SIGSTOPped (suspended, never killed), a
post's spine or harness over 70% only alerts (goal:g7.16.1.11.40.1);
a drop of >= 3 GiB within 30 s alerts. Alerts: journal + {{MEMGUARD_LOG}} + one line in the ~/.notice of each of {{MEMGUARD_ALERT_TO}}
(written BY that post's own uid through runuser, with its agi-notice when it has one: root signs nothing and holds no key; the file stays
the post's own; one line per kind per {{ALERT_COOLDOWN_S}} s, but a stop or resume line is keyed by its pid too, so a second stop is never swallowed). A pid stopped for
low memory is SIGCONTed once MemAvailable has stayed above {{RESUME_FACTOR}}x the low line for {{RESUME_HOLD_S}} s, and the notice line names its unit + pid;
a pid stopped for size is resumed by hand and says so again every {{RENOTIFY_S}} s while it stays stopped.
The tree selection reads argv only as the exact tail equality between one unit's tracer and its child: never a pattern, never printed."""
import os, re, time, signal, subprocess, collections
PAGE = os.sysconf('SC_PAGE_SIZE'); ME = os.getpid()
def meminfo(k): return int(re.search(rf'^{k}:\s+(\d+)', open('/proc/meminfo').read(), re.M).group(1)) * 1024
TOTAL = meminfo('MemTotal')
PROTECT_COMM = {{PROTECT_COMM}}
PROTECT_CMD = re.compile(r'{{PROTECT_CMD}}')
PI_CMD = re.compile(r'{{PI_CMD}}')
POST_CG = re.compile(r'{{POST_CGROUP_RE}}', re.M)
hist = collections.deque(); stopped = {}; warned = set(); noh = set(); unread = set(); last = {}; last_re = {}; pend = []; rec = None
SAFE = re.compile(r'^[A-Za-z0-9._-]+$')
def notice(text):
    for to in '{{MEMGUARD_ALERT_TO}}'.split():
        if not SAFE.match(to): continue
        try:
            pend.append(subprocess.Popen(['timeout', '30', 'runuser', '-u', 'agi-' + to, '--', 'env', 'HOME={{MEMGUARD_STORES}}/' + to, 'sh', '-c',
                              '[ -x ~/bin/agi-notice ] && exec ~/bin/agi-notice add "$0" || echo "$0" >> ~/.notice', text],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        except Exception as e: open('{{MEMGUARD_LOG}}', 'a').write(f'notice to {to} not written: {e!r}\n')
def log(msg, red=False, kind='x'):
    line = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()) + ' ' + msg
    open('{{MEMGUARD_LOG}}', 'a').write(line + '\n'); subprocess.run(['logger', '-t', 'agi-memguard', msg])
    if red and time.time() - last.get(kind, 0) > {{ALERT_COOLDOWN_S}}:
        last[kind] = time.time()
        for k in [k for k, v in last.items() if len(last) > 200 and time.time() - v > {{ALERT_COOLDOWN_S}}]: del last[k]
        notice(f'[memguard-{kind}] ' + msg + f' (ev {int(time.time()):08x})')
def unit_of(pid):
    try: return open(f'/proc/{pid}/cgroup').read().strip().split('\n')[-1].rsplit('/', 1)[-1] or '?'
    except Exception: return '?'
def procs():
    for d in os.listdir('/proc'):
        if not d.isdigit() or int(d) in (1, ME): continue
        try:
            comm = open(f'/proc/{d}/comm').read().strip(); cmd = open(f'/proc/{d}/cmdline').read().replace('\0', ' ')
            rss = int(open(f'/proc/{d}/statm').read().split()[1]) * PAGE
        except Exception: continue
        if cmd: yield int(d), comm, cmd, rss
def post_rows(snap):
    out = {}
    for pid, comm, cmd, rss in snap:
        try:
            m = POST_CG.search(open(f'/proc/{pid}/cgroup').read()); s = open(f'/proc/{pid}/stat').read()
            if m: r = s[s.rindex(')') + 2:].split(); out.setdefault(m.group(0).rstrip('/'), {})[pid] = (int(r[1]), int(r[19]), cmd)
        except Exception: pass
    return out
def guarded(rows):
    kids = collections.defaultdict(list)
    for p, (pp, st, c) in rows.items(): kids[pp].append(p)
    n = min((p for p, (pp, st, c) in rows.items() if pp not in rows), key=lambda p: rows[p][1]); chain = [n]; h = None
    while not h:
        h = max((k for k in kids[n] if rows[k][2].strip() and rows[n][2].endswith(rows[k][2])), key=lambda k: len(rows[k][2]), default=None)
        if h or len(kids[n]) != 1: break
        n = kids[n][0]; chain.append(n)
    out = set(chain)
    def sub(p): return {p}.union(*(sub(k) for k in kids[p]))
    if h:
        out.add(h)
        for k in kids[n]:
            if k != h: out |= sub(k)
    return out, bool(h)
def setadj(pid, v):
    try:
        p = f'/proc/{pid}/oom_score_adj'
        if int(open(p).read()) != v: open(p, 'w').write(str(v))
    except Exception: pass
while True:
    now = time.time(); avail = meminfo('MemAvailable'); hist.append((now, avail)); pend[:] = [q for q in pend if q.poll() is None]
    while hist and now - hist[0][0] > {{HISTORY_S}}: hist.popleft()
    peak = max(a for _, a in hist)
    if peak - avail >= {{SPIKE_BYTES}} << 30: log(f'SPIKE: MemAvailable fell {(peak-avail)>>20} MiB in <=30 s, now {avail>>20} MiB', red=True, kind='spike'); hist.clear(); hist.append((now, avail))
    unprot = []; snap = list(procs()); inpost = set(); keep = set()
    for unit, rows in post_rows(snap).items():
        inpost |= set(rows)
        try:
            g, found = guarded(rows); keep |= g
            if not found and unit not in noh: noh.add(unit); log(f'ALERT {unit}: no harness found under its tracer (its argv is not the tail of the tracer\'s): only the spine chain is protected', red=True, kind='tree')
        except Exception as e:
            if unit not in unread: unread.add(unit); log(f'ALERT {unit}: the process tree could not be read ({e!r}): nothing in it is protected this tick', red=True, kind='tree')
    for pid, comm, cmd, rss in snap:
        prot = pid in keep or (pid not in inpost and (comm in PROTECT_COMM or bool(PROTECT_CMD.search(cmd))))
        if prot:
            setadj(pid, {{PROTECT_OOM_ADJ}})
            try:
                if os.getpriority(os.PRIO_PROCESS, pid) > {{PROTECT_NICE}}: os.setpriority(os.PRIO_PROCESS, pid, {{PROTECT_NICE}})
            except Exception: pass
        elif PI_CMD.search(cmd): setadj(pid, {{PI_OOM_ADJ}})
        if not prot: unprot.append((rss, pid, comm))
        if pid in keep and rss > {{SUSPEND_RATIO}} * TOTAL and pid not in warned:
            warned.add(pid); log(f'ALERT pid {pid} ({comm}) is a post\'s spine or harness: RSS {rss>>20} MiB > {{SUSPEND_PCT}}% of {TOTAL>>20} MiB -- not stopped', red=True, kind='post')
        elif pid not in keep and rss > {{SUSPEND_RATIO}} * TOTAL and pid not in stopped:
            os.kill(pid, signal.SIGSTOP); u = unit_of(pid); stopped[pid] = ('size', comm, u, now); log(f'SUSPENDED pid {pid} ({comm}, unit {u}): RSS {rss>>20} MiB > {{SUSPEND_PCT}}% of {TOTAL>>20} MiB -- resume by hand: kill -CONT {pid}', red=True, kind=f'susp-{pid}')
    if avail < {{LOW_AVAIL_BYTES}} << 30 and unprot:
        rss, pid, comm = max(unprot)
        if pid not in stopped:
            os.kill(pid, signal.SIGSTOP); u = unit_of(pid); stopped[pid] = ('low', comm, u, now); log(f'SUSPENDED pid {pid} ({comm}, unit {u}, RSS {rss>>20} MiB): MemAvailable {avail>>20} MiB < {{LOW_AVAIL_GIB}} GiB -- resumed automatically once MemAvailable holds above {{RESUME_FACTOR}}x that for {{RESUME_HOLD_S}} s, or by hand: kill -CONT {pid}', red=True, kind=f'susp-{pid}')
    lows = [p for p, v in stopped.items() if v[0] == 'low']
    if lows and avail > {{RESUME_FACTOR}} * ({{LOW_AVAIL_BYTES}} << 30):
        rec = rec or now
        if now - rec >= {{RESUME_HOLD_S}}:
            for p in lows:
                try: os.kill(p, signal.SIGCONT); how = 'resumed'
                except Exception as e: how = f'could not resume ({e!r})'
                log(f'RESUMED pid {p} ({stopped[p][1]}, unit {stopped[p][2]}): {how}; MemAvailable {avail>>20} MiB held above {{RESUME_FACTOR}}x the low line for {{RESUME_HOLD_S}} s', red=True, kind=f'resume-{p}'); del stopped[p]
            rec = None
    else: rec = None
    for p, v in stopped.items():
        if v[0] == 'size' and now - last_re.setdefault(p, v[3]) >= {{RENOTIFY_S}}:
            last_re[p] = now; log(f'STILL STOPPED pid {p} ({v[1]}, unit {v[2]}) for {int(now - v[3]) // 60} min (size stop): resume by hand: kill -CONT {p}', red=True, kind=f'still-{p}')
    stopped = {p: v for p, v in stopped.items() if os.path.exists(f'/proc/{p}')}; last_re = {p: x for p, x in last_re.items() if p in stopped}; warned = {p for p in warned if os.path.exists(f'/proc/{p}')}
    time.sleep({{INTERVAL_S}})
