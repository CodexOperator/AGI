#!/usr/bin/env python3
"""agi-memguard (box-owner-S2-L5-V, owner 09-25 after the 04:00Z OOM took every seat down).
Every 5 s: a post's SPINE and HARNESS keep oom_score_adj -900 + nice -5, chosen by the post's cgroup
(/agi.slice/agi-post@*.service) AND their place in the unit's process tree, never by a command name: the spine is the chain
from the unit's oldest process down to the first process that has more than one child or a child whose argv is the tail of
its own (the tracer, and the harness is that child), plus everything the tracer runs that is not the harness; the harness's
DESCENDANTS (tool calls, MCP servers, kids) and anything orphaned out of the tree stay unprotected. tmux and the stream keep
-900 too (by command, outside the posts); every other pi worker gets +500 (the kernel kills them first);
a process over 70% of RAM, or the largest unprotected one when MemAvailable < 1 GiB, is SIGSTOPped (suspended, never killed), a
post's spine or harness over 70% only alerts (goal:g7.16.1.11.40.1);
a drop of >= 3 GiB within 30 s alerts. Alerts: journal + /var/log/agi-memguard.log
+ one [red] dm to box-owner (rate-limited 10 min)."""
import os, re, time, signal, subprocess, collections
PAGE = os.sysconf('SC_PAGE_SIZE'); ME = os.getpid()
def meminfo(k): return int(re.search(rf'^{k}:\s+(\d+)', open('/proc/meminfo').read(), re.M).group(1)) * 1024
TOTAL = meminfo('MemTotal')
PROTECT_COMM = {'claude', 'tmux: server', 'ffmpeg', 'tmux'}
PROTECT_CMD = re.compile(r'streamer-stub|rotate\.py launch-wrapper|agi-memguard')
PI_CMD = re.compile(r'\.npm-global/(bin/pi\b|lib/node_modules/\S*pi)')
POST_CG = re.compile(r'^0::/agi\.slice/agi-post@[^/\n]+\.service(/|$)', re.M)
hist = collections.deque(); stopped = set(); warned = set(); noh = set(); last_alert = 0.0
def log(msg, red=False):
    global last_alert
    line = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()) + ' ' + msg
    open('/var/log/agi-memguard.log', 'a').write(line + '\n'); subprocess.run(['logger', '-t', 'agi-memguard', msg])
    if red and time.time() - last_alert > 600:
        last_alert = time.time()
        subprocess.run(['sudo', '-u', 'box-owner', '-H', 'python3', '/box/agi/extensions/agi/bin/send.py', 'send', '--from', 'box-owner', 'box-owner', '[red] memguard: ' + msg],
                       cwd='/box/agi', timeout=60, capture_output=True)
def procs():
    for d in os.listdir('/proc'):
        if not d.isdigit() or int(d) in (1, ME): continue
        try:
            comm = open(f'/proc/{d}/comm').read().strip(); cmd = open(f'/proc/{d}/cmdline').read().replace('\0', ' ')
            rss = int(open(f'/proc/{d}/statm').read().split()[1]) * PAGE
        except Exception: continue
        if cmd: yield int(d), comm, cmd, rss
def post_rows(snap):
    out = {}
    for pid, comm, cmd, rss in snap:
        try:
            m = POST_CG.search(open(f'/proc/{pid}/cgroup').read()); s = open(f'/proc/{pid}/stat').read()
            if m: r = s[s.rindex(')') + 2:].split(); out.setdefault(m.group(0).rstrip('/'), {})[pid] = (int(r[1]), int(r[19]), cmd)
        except Exception: pass
    return out
def guarded(rows):
    kids = collections.defaultdict(list)
    for p, (pp, st, c) in rows.items(): kids[pp].append(p)
    n = min((p for p, (pp, st, c) in rows.items() if pp not in rows), key=lambda p: rows[p][1]); chain = [n]; h = None
    while not h:
        h = max((k for k in kids[n] if rows[k][2].strip() and rows[n][2].endswith(rows[k][2])), key=lambda k: len(rows[k][2]), default=None)
        if h or len(kids[n]) != 1: break
        n = kids[n][0]; chain.append(n)
    out = set(chain)
    def sub(p): return {p}.union(*(sub(k) for k in kids[p]))
    if h:
        out.add(h)
        for k in kids[n]:
            if k != h: out |= sub(k)
    return out, bool(h)
def setadj(pid, v):
    try:
        p = f'/proc/{pid}/oom_score_adj'
        if int(open(p).read()) != v: open(p, 'w').write(str(v))
    except Exception: pass
while True:
    now = time.time(); avail = meminfo('MemAvailable'); hist.append((now, avail))
    while hist and now - hist[0][0] > 30: hist.popleft()
    peak = max(a for _, a in hist)
    if peak - avail >= 3 << 30: log(f'SPIKE: MemAvailable fell {(peak-avail)>>20} MiB in <=30 s, now {avail>>20} MiB', red=True); hist.clear(); hist.append((now, avail))
    unprot = []; snap = list(procs()); inpost = set(); keep = set()
    for unit, rows in post_rows(snap).items():
        inpost |= set(rows)
        try:
            g, found = guarded(rows); keep |= g
            if not found and unit not in noh: noh.add(unit); log(f'ALERT {unit}: no harness found under its tracer (its argv is not the tail of the tracer\'s): only the spine chain is protected', red=True)
        except Exception as e: log(f'ALERT {unit}: the process tree could not be read ({e!r}): nothing in it is protected this tick', red=True)
    for pid, comm, cmd, rss in snap:
        prot = pid in keep or (pid not in inpost and (comm in PROTECT_COMM or bool(PROTECT_CMD.search(cmd))))
        if prot:
            setadj(pid, -900)
            try:
                if os.getpriority(os.PRIO_PROCESS, pid) > -5: os.setpriority(os.PRIO_PROCESS, pid, -5)
            except Exception: pass
        elif PI_CMD.search(cmd): setadj(pid, 500)
        if not prot: unprot.append((rss, pid, comm))
        if pid in keep and rss > 0.70 * TOTAL and pid not in warned:
            warned.add(pid); log(f'ALERT pid {pid} ({comm}) is a post\'s spine or harness: RSS {rss>>20} MiB > 70% of {TOTAL>>20} MiB -- not stopped', red=True)
        elif pid not in keep and rss > 0.70 * TOTAL and pid not in stopped:
            os.kill(pid, signal.SIGSTOP); stopped.add(pid); log(f'SUSPENDED pid {pid} ({comm}): RSS {rss>>20} MiB > 70% of {TOTAL>>20} MiB -- resume: kill -CONT {pid}', red=True)
    if avail < 1 << 30 and unprot:
        rss, pid, comm = max(unprot)
        if pid not in stopped:
            os.kill(pid, signal.SIGSTOP); stopped.add(pid); log(f'SUSPENDED pid {pid} ({comm}, RSS {rss>>20} MiB): MemAvailable {avail>>20} MiB < 1 GiB -- resume: kill -CONT {pid}', red=True)
    stopped = {p for p in stopped if os.path.exists(f'/proc/{p}')}; warned = {p for p in warned if os.path.exists(f'/proc/{p}')}
    time.sleep(5)
