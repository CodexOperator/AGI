{
  "schema": "magic-pane-event-routes/v2",
  "goal": "goal:g7.16.1.7.3.1",
  "note": "SoT for goal:g7.16.1.7.3. Owner: inject ALL info via uniform tool-call turn; tool RETURN is the message; always tagged DM vs engine. Pane owns no transport (g7.32.6). Not messaging adapter integration. Cutover (g7.16.1.7.3.4): legacy routes bypassed; inject+poll is THE path.",
  "inject": {
    "shape": "tool_call_turn",
    "message_is": "tool_return",
    "channels": [
      "dm",
      "engine"
    ]
  },
  "required_kinds": [
    "first_turn_docs",
    "memory_alarm",
    "message_receipt",
    "rotation_prompt",
    "write_commit_result"
  ],
  "parent_measured_legacy_routes": [
    "session_start_hook_paste",
    "user_prompt_submit_meter",
    "send_py_nudge",
    "cc_send_message"
  ],
  "routes": [
    {
      "event_kind": "first_turn_docs",
      "channel": "engine",
      "kind_tag": "engine.first_turn_docs",
      "target_route": "tool_call_turn",
      "legacy_routes": [
        "session_start_hook_paste"
      ]
    },
    {
      "event_kind": "memory_alarm",
      "channel": "engine",
      "kind_tag": "engine.memory_alarm",
      "target_route": "tool_call_turn",
      "legacy_routes": [
        "user_prompt_submit_meter"
      ]
    },
    {
      "event_kind": "message_receipt",
      "channel": "dm",
      "kind_tag": "dm.message_receipt",
      "target_route": "tool_call_turn",
      "legacy_routes": [
        "send_py_nudge",
        "cc_send_message"
      ]
    },
    {
      "event_kind": "rotation_prompt",
      "channel": "engine",
      "kind_tag": "engine.rotation_prompt",
      "target_route": "tool_call_turn",
      "legacy_routes": [
        "session_start_hook_paste",
        "send_py_nudge"
      ]
    },
    {
      "event_kind": "write_commit_result",
      "channel": "engine",
      "kind_tag": "engine.write_commit_result",
      "target_route": "tool_call_turn",
      "legacy_routes": [
        "user_prompt_submit_meter",
        "send_py_nudge"
      ]
    }
  ],
  "build_lane": {
    "harness": "pi",
    "row": "free",
    "adapter": "extensions/agi/bin/adapters/pi_adapter.py",
    "template": "extensions/agi/templates/harness/pi.toml",
    "cc_compat": "pi extension events session_start/before_agent_start/tool_result mirror CC SessionStart/UserPromptSubmit/PostToolUse; prove inject contract on free-pi before CC cutover"
  },
  "cutover": {
    "goal": "goal:g7.16.1.7.3.4",
    "active_route": "tool_call_turn",
    "legacy_policy": "bypassed",
    "path": "magic_pane_inject.build_envelope \u2192 magic_pane_poll.enqueue \u2192 poll",
    "deferred": [
      "live tmux attach",
      "pane liveness-census row wiring (g7.16.1.1.6) \u2014 not required (dry lifecycle proved)"
    ],
    "legacy_routes": {
      "session_start_hook_paste": {
        "status": "bypassed",
        "replaced_by": "tool_call_turn"
      },
      "user_prompt_submit_meter": {
        "status": "bypassed",
        "replaced_by": "tool_call_turn"
      },
      "send_py_nudge": {
        "status": "bypassed",
        "replaced_by": "tool_call_turn"
      },
      "cc_send_message": {
        "status": "bypassed",
        "replaced_by": "tool_call_turn"
      }
    },
    "note": "Code-path cutover + pane runner + dry lifecycle (spawn/attach->tick/consume). Messaging adapter (g7.32.2*) untouched. Live tmux attach still deferred.",
    "runner": {
      "goal": "goal:g7.16.1.7.3.5",
      "module": "magic_pane_runner",
      "path": "cutover.deliver \u2192 poll \u2192 render_turn (tool_call_turn; message=tool_return)",
      "live_hook_uninstall": "done (surgical SessionStart/UserPromptSubmit legacy delivery)"
    },
    "lifecycle": {
      "goal": "goal:g7.16.1.7.3.6",
      "module": "magic_pane_lifecycle",
      "hooks": [
        "spawn",
        "attach"
      ],
      "path": "on_spawn->runner.consume(first_turn_docs); on_attach->runner.tick (dry/fixture; no live tmux)",
      "pi_events": {
        "session_start": "spawn_or_attach",
        "before_agent_start": "mark_busy",
        "tool_result": "mark_idle_and_tick"
      }
    }
  }
}
